{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "styled-system/*": [
        "styled-system/*"
      ]
    }
  },
  "include": [
    "vite.app.config.ts",
    "vite.app.web.config.ts",
    "vitest.config.ts",
    "vite.alias.ts",
    "package.json",
    "src",
    "styled-system",
    "vitePlugins",
    "scripts",
    "test"
  ],
  "references": []
}
